nextflow_process {

    name "Test Process ASSEMBLE_READS"
    script "modules/assemble-reads.nf"
    process "ASSEMBLE_READS"

    test("Terminates with no errors") {

        when {
            params {

            }
            process {
                """
                input[0] = Channel.of(["${projectDir}/tests/data/SRR1297442_1.fastq", "${projectDir}/tests/data/SRR1297442_2.fastq"])
                """
            }
        }

        then {
            assertAll(
                { assert process.success }
            )
        }

    }

    test("Produces output files with correct filenames") {

        when {
            params {

            }
            process {
                """
                input[0] = Channel.of(["${projectDir}/tests/data/SRR1297442_1.fastq", "${projectDir}/tests/data/SRR1297442_2.fastq"])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert new File("${process.out[0][0]}/scaffolds.fasta").exists() }
            )
        }
        
    }
}
nextflow_process {

    name "Test Process TRIM_READS"
    script "modules/trim-reads.nf"
    process "TRIM_READS"

    test("Terminates with no errors") {

        when {
            params {

            }
            process {
                """
                input[0] = Channel.of(["SRR33661552", "${projectDir}/tests/data/SRR33661552_1.fastq", "${projectDir}/tests/data/SRR33661552_2.fastq"])
                """
            }
        }

        then {
            assertAll(
                { assert process.success }
            )
        }

    }

    test("Produces output files with correct ID and filenames") {

        when {
            params {

            }
            process {
                """
                input[0] = Channel.of(["SRR33661552", "${projectDir}/tests/data/SRR33661552_1.fastq", "${projectDir}/tests/data/SRR33661552_2.fastq"])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.paired_reads[0][0] == "SRR33661552" },
                { assert new File("${process.out.paired_reads[0][1]}").exists() },
                { assert new File("${process.out.paired_reads[0][2]}").exists() },
                { assert process.out.unpaired_reads[0][0] == "SRR33661552" },
                { assert new File("${process.out.unpaired_reads[0][1]}").exists() },
                { assert new File("${process.out.unpaired_reads[0][2]}").exists() }
            )
        }
        
    }
}